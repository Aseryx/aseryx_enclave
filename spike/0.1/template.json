{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "containerGroupName": {
      "type": "String",
      "defaultValue": "enclave-spike-attest"
    }
  },
  "resources": [
    {
      "type": "Microsoft.ContainerInstance/containerGroups",
      "apiVersion": "2023-05-01",
      "name": "[parameters('containerGroupName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "containers": [
          {
            "name": "skr-sidecar-container",
            "properties": {
              "command": [
                "/skr.sh"
              ],
              "environmentVariables": [],
              "image": "mcr.microsoft.com/aci/skr:2.12",
              "resources": {
                "requests": {
                  "cpu": 1,
                  "memoryInGB": 2
                }
              },
              "ports": [
                {
                  "port": 8080
                }
              ]
            }
          },
          {
            "name": "test-attest-maa-client-container",
            "properties": {
              "command": [
                "/tests/skr/attest_client.sh"
              ],
              "environmentVariables": [
                {
                  "name": "AttestClientMAAEndpoint",
                  "value": "sharedeus.eus.attest.azure.net"
                },
                {
                  "name": "AttestClientRuntimeData",
                  "value": ""
                }
              ],
              "image": "mcr.microsoft.com/aci/skr:2.12",
              "resources": {
                "requests": {
                  "cpu": 1,
                  "memoryInGB": 1
                }
              }
            }
          }
        ],
        "osType": "Linux",
        "restartPolicy": "Never",
        "ipAddress": {
          "type": "Public",
          "ports": [
            {
              "protocol": "tcp",
              "port": 8080
            }
          ]
        },
        "sku": "Confidential",
        "confidentialComputeProperties": {
          "ccePolicy": ""
        }
      }
    }
  ]
}
